  ],
  "vectorSearch": {
    "algorithms": [
      {
        "name": "kb-hnsw",
        "kind": "hnsw",
        "hnswParameters": {
          "m": 4,
          "efConstruction": 400,
          "efSearch": 500,
          "metric": "cosine"
        }
      }
    ],
    "profiles": [
      {
        "name": "kb-vector-profile",
        "algorithm": "kb-hnsw"
      }
    ]
  },
  "semantic": {
    "configurations": [
      {
        "name": "kb-semantic-config",
        "prioritizedFields": {
          "titleField": {
            "fieldName": "sectionTitle"
          },
          "prioritizedContentFields": [
            {
              "fieldName": "content"
            },
            {
              "fieldName": "contentDescription"
            }
          ],
          "prioritizedKeywordsFields": [
            {
              "fieldName": "sectionPath"
            },
            {
              "fieldName": "contentType"
            },
            {
              "fieldName": "sqlSectionTitle"
            }
          ]
        }
      }
    ]
  },
  "suggesters": [
    {
      "name": "sg",
      "searchMode": "analyzingInfixMatching",
      "sourceFields": [
        "pageTitle",
        "sectionTitle",
        "sqlSectionTitle"
      ]
    }
  ],
  "corsOptions": {
    "allowedOrigins": [
      "*"
    ],
    "maxAgeInSeconds": 300
  },
  "notes": {
    "ingestionShape": "One Azure Search document per content unit (table row, sql statement, or text block).",
    "supportedContentTypes": [
      "table",
      "sql",
      "text"
    ],
    "vectorDimensionsNote": "Set contentVector.dimensions to match your embedding model output size.",
    "apiVersionHint": "Use a recent Azure Search API version that supports vectorSearchProfile and semantic configuration."
  }
}