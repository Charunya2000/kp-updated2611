# Work around npm 10.2.x arborist crash ("Cannot read properties of null (reading 'edgesOut')")
# in peer-dependency resolution (#loadPeerSet) that breaks `npm install` on the CI runner.
legacy-peer-deps=true
registry=https://artifactory-bluemix.kp.org/artifactory/api/npm/npm-bluemix/
ca=null
save=true
save-exact=true
